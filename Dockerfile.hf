FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Ingest initial 3GPP dataset during container build
RUN python -m app.ingestion.run

# Expose HF default port
EXPOSE 7860

# Command to launch Streamlit UI on Hugging Face Spaces port 7860
CMD ["streamlit", "run", "frontend/streamlit_app.py", "--server.port=7860", "--server.address=0.0.0.0"]
